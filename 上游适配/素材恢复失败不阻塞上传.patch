+async function restoreAsset(asset: Asset): Promise<Asset> {
+    // 恢复是后台索引工作，单个过期/损坏媒体不能让整个素材库永远处于未完成状态。
+    try {
+        if ((asset.kind === "video" || asset.kind === "audio") && asset.data.storageKey) {
+            const url = await resolveMediaUrl(asset.data.storageKey, asset.data.url).catch(() => asset.data.url);
+            return { ...asset, data: { ...asset.data, url } };
+        }
+        if (asset.kind !== "image") return asset;
+        if (asset.data.storageKey) {
+            void ensureImagePreview(asset.data.storageKey).catch(() => undefined);
+            const coverUrl = asset.coverUrl.startsWith("blob:")
+                ? await resolveImageUrl(asset.data.storageKey, asset.coverUrl).catch(() => asset.coverUrl)
+                : asset.coverUrl;
+            const dataUrl = await resolveImageUrl(asset.data.storageKey, asset.data.dataUrl).catch(() => asset.data.dataUrl);
+            return { ...asset, coverUrl, data: { ...asset.data, dataUrl } };
+        }
+        // [image omitted] 是历史兼容占位，恢复阶段不重新上传或请求网络；保留记录，待用户打开/替换时再处理。
+        return asset;
+    } catch {
+        return asset;
+    }
+}
