+function withMediaStorageTimeout<T>(operation: Promise<T>, key: string) {
+    return new Promise<T>((resolve, reject) => {
+        const timer = window.setTimeout(() => {
+            const error = new Error(`本机媒体保存超时（${key}）。请检查本机存储连接后重试。`);
+            error.name = "MediaStorageTimeoutError";
+            reject(error);
+        }, MEDIA_STORAGE_TIMEOUT_MS);
+        operation.then(value => { window.clearTimeout(timer); resolve(value); }, error => { window.clearTimeout(timer); reject(error); });
+    });
