@@ -0,0 +1,25 @@
+/* 旧顶栏样式迁入并局部化。没有覆盖作者选择器，没有固定在弹窗上方。 */
+.header { display: flex; position: relative; height: 84px; min-height: 84px; flex: 0 0 84px; align-items: center; padding: 0 24px; border-bottom: 1px solid #e5e5e5; background: #fff; color: #161719; font: 14px/20px "Guan Home Geist", "Guan Home Geist Fallback", ui-sans-serif, system-ui, sans-serif; }
+.header[data-theme="dark"] { background: #171717; color: #f4f4f5; border-color: rgb(255 255 255 / 10%); }
+.brand { display: inline-flex; width: auto; min-width: max-content; height: 32px; margin-left: 24px; align-items: center; gap: 10px; flex: 0 0 auto; }
+.brand img { width: 32px; height: 32px; object-fit: contain; }
+.header[data-theme="dark"] .brand img { filter: invert(1) brightness(1.3); }
+.brand span { font: 650 16px/1 "Guan Home Geist", ui-sans-serif, system-ui, sans-serif; letter-spacing: -.01em; white-space: nowrap; user-select: none; }
+.controls { display: flex; align-items: center; justify-content: flex-start; gap: 8px; flex: 1 1 0; min-width: 0; margin-left: 24px; padding-right: 104px; }
+.productNav { flex: 1 1 0; min-width: 0; }
+.actions { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6px; margin-left: 10px; }
+.actions button { display: inline-flex; align-items: center; gap: 5px; height: 30px; padding: 0 9px; border: 0; border-radius: 8px; background: transparent; color: inherit; font: 12px/1.2 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; cursor: pointer; }
+.actions svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; }
+.sheetLabel { font-size: 13px; white-space: nowrap; }
+.fileTrigger { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: min(250px,26vw); min-width: 160px; height: 46px; flex: 0 0 auto; padding: 0 14px 0 16px; border: 1px solid rgb(20 24 32 / 12%); border-radius: 13px; background: #fff; color: #17181a; font: 13px/1.2 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
+.fileTrigger span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.fileTrigger svg { width: 20px; height: 20px; flex: 0 0 20px; fill: none; stroke: #71757a; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
+.header[data-theme="dark"] .fileTrigger { border-color: rgb(255 255 255 / 14%); background: rgb(29 30 32 / 97%); color: #f4f4f5; }
+.themeButton, .settingsButton { position: absolute; top: 21px; display: inline-flex; width: 42px; height: 42px; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 12px; background: transparent; color: inherit; cursor: pointer; }
+.themeButton { right: 76px; }
+.settingsButton { right: 24px; }
+.themeButton svg, .settingsButton svg { width: 24px; height: 24px; }
+.header button:disabled { cursor: not-allowed; }
+.header button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
+@media(max-width:820px) { .brand { margin-left:0; } .brand span { display:none; } .fileTrigger { width:min(210px,30vw); min-width:140px; } }
+@media(max-width:640px) { .header { padding:0 12px; } .controls { overflow-x:auto; margin-left:8px; } .sheetLabel { display:none; } .fileTrigger { min-width:118px; } }
