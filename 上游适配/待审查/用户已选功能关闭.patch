@@ -0,0 +1,27 @@
+import { Button } from "antd";
+import { Navigate, useNavigate } from "react-router-dom";
+import { useTranslation } from "react-i18next";
+import { useCanvasStore } from "@/stores/canvas/use-canvas-store";
+import { entryProjectId } from "@/guan/功能开关";
+
+// 原版首页/项目列表关闭后的最小落点，不加载原页面，也不在初始化时写入新画布。
+export function CanvasEntry() {
+    const { t } = useTranslation();
+    const navigate = useNavigate();
+    const hydrated = useCanvasStore((state) => state.hydrated);
+    const projects = useCanvasStore((state) => state.projects);
+    const createProject = useCanvasStore((state) => state.createProject);
+    const id = entryProjectId(projects);
+
+    if (!hydrated) return <main className="grid h-full place-items-center bg-background text-foreground" role="status">{t("canvas.opening")}</main>;
+    if (id) return <Navigate to={`/canvas/${encodeURIComponent(id)}`} replace />;
+
+    return (
+        <main className="grid h-full place-items-center bg-background text-foreground">
+            <Button type="primary" onClick={() => {
+                const projectId = createProject(t("canvas.defaultTitle", { count: 1 }));
+                navigate(`/canvas/${encodeURIComponent(projectId)}`, { replace: true });
+            }}>{t("canvas.create")}</Button>
+        </main>
+    );
+}
