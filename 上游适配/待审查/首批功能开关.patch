@@ -0,0 +1,25 @@
+// 构建期产品策略，不从网址、用户数据库或浏览器配置读取，关闭功能不删除数据。
+export type ProductFeature = "webdav" | "externalAgent" | "analytics";
+
+export const productFeatures: Readonly<Record<ProductFeature, boolean>> = Object.freeze({
+    webdav: false,
+    externalAgent: false,
+    analytics: false,
+});
+
+const featureNames: Record<ProductFeature, string> = {
+    webdav: "WebDAV 同步",
+    externalAgent: "外部 Agent",
+    analytics: "访问统计",
+};
+
+export function requireProductFeature(feature: ProductFeature): void {
+    if (productFeatures[feature] !== true) {
+        throw Object.assign(new Error(`${featureNames[feature] ?? "此功能"}已在本产品关闭；原有数据仍保留。`), { code: "product_feature_disabled" });
+    }
+}
+
+// 关闭的页签不能通过旧的 configTab 状态或程序调用重新打开。
+export function resolveConfigTab<T extends string>(tab: T): T | "channels" {
+    return tab === "webdav" && !productFeatures.webdav ? "channels" : tab;
+}
