+// 仅由具体获批的应用启动器安装。这里不自行索取令牌，不接旧浏览器存储。
+export interface SQLiteInstance {
+    getItem<T>(key: string): Promise<T | null>;
+    setItem<T>(key: string, value: T): Promise<T>;
+    removeItem(key: string): Promise<unknown>;
+    clear(): Promise<unknown>;
+    iterate<T, U>(iterator: (value: T, key: string, index: number) => U | void): Promise<U | void>;
+}
+export type SQLiteUsage = {
+    usage: number;
+    quota: number | null;
+    contentBytes: number;
+    databases: Array<{ name: string; version: number; bytes: number; stores: Array<{ name: string; records: number; bytes: number }> }>;
+};
+export interface SQLiteRuntime {
+    createInstance(options: { name?: string; storeName?: string }): SQLiteInstance;
+    flush(): Promise<unknown>;
+    getStatus(): { state: string; pending: number; errors: string[] };
+    readUsage(): Promise<SQLiteUsage>;
+}
+declare global {
+    interface Window {
+        __guanSQLiteHost?: { initialize(): Promise<SQLiteRuntime> };
+    }
+}
+
+let runtime: SQLiteRuntime | null = null;
+let appState: SQLiteInstance;
+let preferencesStore: SQLiteInstance;
+const stateCache = new Map<string, string>();
+const preferencesCache = new Map<string, string>();
+const sessionCache = new Map<string, string>();
+const writes = new Set<Promise<unknown>>();
+const failed = new Map<string, unknown>();
+const scheduled = new Map<string, { value: string; timer: ReturnType<typeof setTimeout>; resolve: () => void; reject: (reason: unknown) => void; promise: Promise<void> }>();
+
+function ready() {
+    if (!runtime) throw new Error("本机存储尚未初始化，不允许退回浏览器数据库。");
+    return runtime;
+}
+function statusChanged() {
+    if (typeof window !== "undefined") window.dispatchEvent(new CustomEvent("guan:storage-status", { detail: storageStatus() }));
+}
+export function storageStatus() {
+    return { state: failed.size || runtime?.getStatus().state === "error" ? "error" : writes.size || scheduled.size ? "saving" : "saved", pending: writes.size + scheduled.size };
+}
+function track<T>(key: string, promise: Promise<T>) {
+    writes.add(promise); statusChanged();
+    // 旁路观测失败，不改变原Promise的拒绝语义，也不会产生未处理拒绝。
+    promise.then(() => failed.delete(key), error => failed.set(key, error)).finally(() => { writes.delete(promise); statusChanged(); });
+    return promise;
+}
+
+export async function initializeSQLiteApplication() {
+    if (runtime) return;
+    if (typeof window === "undefined" || !window.__guanSQLiteHost) throw new Error("本机SQLite服务尚未授权接入。未加载空画布，也未使用浏览器存储。");
+    const candidate = await window.__guanSQLiteHost.initialize();
+    const app = candidate.createInstance({ name: "infinite-canvas", storeName: "app_state" });
+    const prefs = candidate.createInstance({ name: "infinite-canvas", storeName: "preferences" });
+    const nextState = new Map<string, string>(), nextPreferences = new Map<string, string>();
+    await app.iterate<unknown, void>((value, key) => {
+        if (typeof value !== "string") throw new Error("应用状态格式错误，未作为空库继续。");
+        const parsed: unknown = JSON.parse(value);
+        if (!parsed || typeof parsed !== "object" || !("state" in parsed) || !parsed.state || typeof parsed.state !== "object") throw new Error("应用状态结构错误，停止初始化。");
+        nextState.set(key, value);
+    });
+    await prefs.iterate<unknown, void>((value, key) => {
+        if (typeof value !== "string") throw new Error("偏好设置格式错误，停止初始化。");
+        nextPreferences.set(key, value);
+    });
+    // 所有读取完成后一次发布，避免默认值先写回覆盖数据库。
+    for (const [key, value] of nextState) stateCache.set(key, value);
+    for (const [key, value] of nextPreferences) preferencesCache.set(key, value);
+    appState = app; preferencesStore = prefs; runtime = candidate;
+    window.addEventListener("beforeunload", event => {
+        const status = storageStatus();
+        if (status.state === "saving" || status.state === "error") { event.preventDefault(); event.returnValue = ""; }
+    });
+    statusChanged();
+}
+
+export const sqliteStateStorage = {
+    getItem(key: string) { ready(); return stateCache.get(key) ?? null; },
+    setItem(key: string, value: string) { ready(); stateCache.set(key, value); return track("state:" + key, appState.setItem(key, value).then(() => {})); },
+    removeItem(key: string) { ready(); stateCache.delete(key); return track("state:" + key, appState.removeItem(key)).then(() => {}); },
+};
+// 同步读取仅来自启动前加载的内存快照；写入仍要等SQLite ACK才算成功。
+export const sqlitePreferences = {
+    getItem(key: string) { ready(); return preferencesCache.get(key) ?? null; },
+    setItem(key: string, value: string) { ready(); preferencesCache.set(key, value); track("pref:" + key, preferencesStore.setItem(key, value)); },
+    removeItem(key: string) { ready(); preferencesCache.delete(key); track("pref:" + key, preferencesStore.removeItem(key)); },
+};
+// 窗口身份只活在本页内存，不能把不同窗口的client-id存成全工作区共用值。
+export const sessionMemory = {
+    getItem(key: string) { return sessionCache.get(key) ?? null; },
+    setItem(key: string, value: string) { sessionCache.set(key, value); },
+};
+export const sqliteForage = {
+    createInstance(options: { name?: string; storeName?: string }) { return ready().createInstance(options); },
+};
+
+function startScheduled(key: string) {
+    const entry = scheduled.get(key);
+    if (!entry) return;
+    clearTimeout(entry.timer); scheduled.delete(key);
+    sqliteStateStorage.setItem(key, entry.value).then(entry.resolve, entry.reject);
+}
+export function scheduleStateSave(key: string, value: string) {
+    ready();
+    const existing = scheduled.get(key);
+    if (existing) { existing.value = value; clearTimeout(existing.timer); existing.timer = setTimeout(() => startScheduled(key), 400); return existing.promise; }
+    let resolve!: () => void, reject!: (reason: unknown) => void;
+    const promise = new Promise<void>((success, failure) => { resolve = success; reject = failure; });
+    scheduled.set(key, { value, timer: setTimeout(() => startScheduled(key), 400), resolve, reject, promise });
+    promise.catch(() => {}); statusChanged(); return promise;
+}
+export async function flushSQLiteStorage() {
+    ready();
+    for (const key of [...scheduled.keys()]) startScheduled(key);
+    await Promise.all([...writes]); await runtime!.flush();
+    if (failed.size || writes.size || scheduled.size) throw new Error("本机保存尚未确认，不能继续关闭或切换服务。");
+}
+export function readSQLiteUsage() { return ready().readUsage(); }
