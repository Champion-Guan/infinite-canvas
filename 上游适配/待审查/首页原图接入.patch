+++ b/web/src/guan/首页.module.css
@@ -0,0 +1,242 @@
+.page {
+  --home-background: #fff;
+  --home-text: #17181a;
+  --home-muted: #72757a;
+  --home-preview: #f5f5f5;
+  --home-card: #fff;
+  --home-border: #ddd;
+  --home-dot: #e5e5e5;
+  box-sizing: border-box;
+  height: 100%;
+  overflow: auto;
+  color: var(--home-text);
+  background: var(--home-background);
+}
+
+.page[data-theme="dark"] {
+  --home-background: #171717;
+  --home-text: #f5f5f5;
+  --home-muted: #a3a3a3;
+  --home-preview: #262626;
+  --home-card: #202020;
+  --home-border: #404040;
+  --home-dot: #404040;
+}
+
+.page * {
+  box-sizing: border-box;
+}
+.columns {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  align-items: center;
+  gap: 32px;
+  width: 100%;
+  min-height: 100%;
+  padding: clamp(24px, 3vw, 56px);
+  text-align: center;
+}
+.preview,
+.actions {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 24px;
+  min-width: 0;
+}
+.page h1 {
+  margin: 0 0 12px;
+  font-size: clamp(28px, 2.5vw, 48px);
+  line-height: 1.25;
+  font-weight: 600;
+}
+.page h2 {
+  margin: 0 0 16px;
+  font-size: clamp(24px, 2vw, 36px);
+  line-height: 1.3;
+  font-weight: 500;
+}
+.page p {
+  margin: 0;
+  max-width: 560px;
+  color: var(--home-muted);
+  font-size: clamp(14px, 1.15vw, 20px);
+  line-height: 1.7;
+}
+.carousel {
+  width: 100%;
+  max-width: 660px;
+}
+.template {
+  padding: clamp(14px, 2vw, 26px);
+  border-radius: 20px;
+  background: var(--home-preview);
+}
+.collage {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 16px minmax(0, 1.15fr) minmax(0, 2fr);
+  align-items: start;
+  gap: 12px;
+}
+.collage figure {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  min-width: 0;
+  margin: 0;
+}
+.collage figcaption {
+  color: var(--home-muted);
+  font-size: 12px;
+  white-space: nowrap;
+}
+.collage img {
+  display: block;
+  width: 100%;
+  border-radius: 7px;
+  background: var(--home-card);
+}
+.sourceImages > div {
+  display: grid;
+  gap: 10px;
+}
+.sourceImages img {
+  aspect-ratio: 1;
+  object-fit: contain;
+}
+.longPage img {
+  height: auto;
+}
+.resultImages > div {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 8px;
+}
+.resultImages img {
+  aspect-ratio: 1;
+  object-fit: cover;
+}
+.direction {
+  align-self: center;
+  color: var(--home-muted);
+}
+.sample {
+  color: var(--home-muted);
+  font-size: 12px;
+}
+.sample {
+  display: block;
+  margin-top: 22px;
+}
+.carouselControls {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 20px;
+  margin-top: 16px;
+}
+.arrow {
+  width: 28px;
+  height: 28px;
+  border: 0;
+  border-radius: 6px;
+  color: var(--home-text);
+  background: transparent;
+  font-size: 26px;
+  line-height: 1;
+  cursor: pointer;
+}
+.arrow:hover {
+  background: var(--home-preview);
+}
+.dots {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.dots button {
+  position: relative;
+  width: 26px;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  cursor: pointer;
+}
+.dots button::after {
+  position: absolute;
+  inset: 11px 5px;
+  content: "";
+  border-radius: 6px;
+  background: var(--home-dot);
+}
+.dots button[aria-current="true"]::after {
+  background: var(--home-text);
+}
+.buttons {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 14px;
+}
+.buttons button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 12px 20px;
+  border: 1px solid var(--home-border);
+  border-radius: 12px;
+  color: var(--home-text);
+  background: var(--home-background);
+  font: inherit;
+  font-size: clamp(15px, 1.2vw, 20px);
+  cursor: pointer;
+}
+.buttons .primary {
+  color: var(--home-background);
+  background: var(--home-text);
+  border-color: var(--home-text);
+}
+.buttons button:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+}
+.page button:focus-visible {
+  outline: 2px solid var(--home-text);
+  outline-offset: 4px;
+}
+.actions .note {
+  max-width: 440px;
+  font-size: 12px;
+}
+
+@media (max-width: 900px) {
+  .columns {
+    grid-template-columns: minmax(0, 1fr);
+    align-content: center;
+    gap: 40px;
+    padding: 28px 16px 40px;
+  }
+  .preview,
+  .actions {
+    gap: 20px;
+  }
+  .collage {
+    grid-template-columns: minmax(0, 1fr) 12px minmax(0, 1.15fr) minmax(0, 2fr);
+    gap: 8px;
+  }
+  .collage figcaption {
+    font-size: 10px;
+  }
+  .collage figure {
+    gap: 8px;
+  }
+  .resultImages > div {
+    gap: 5px;
+  }
+  .template {
+    padding: 20px 12px;
+  }
+}
