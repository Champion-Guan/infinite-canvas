@@ -0,0 +1,147 @@
+import { useState } from "react";
+import styles from "./首页.module.css";
+
+const templates = [
+  { title: "游戏手柄" },
+  { title: "运动鞋" },
+  { title: "智能手表" },
+] as const;
+const imageUrl = (group: number, kind: string, index: number) =>
+  `/guan/首页轮播/第${group}组-${kind}${index}.webp`;
+
+type Props = { theme: "light" | "dark"; onCreate: () => void };
+
+// 恢复旧版两列首页与获用户确认的原轮播图片；不加载旧归档页面或DOM脚本。
+export function WorkbenchHome({ theme, onCreate }: Props) {
+  const [index, setIndex] = useState(0);
+  const template = templates[index];
+
+  return (
+    <main className={styles.page} data-theme={theme} aria-label="工作台首页">
+      <div className={styles.columns}>
+        <section className={styles.preview} aria-labelledby="guan-home-title">
+          <div>
+            <h1 id="guan-home-title">A+ 详情页</h1>
+            <p>上传商品图，AI 即刻生成符合多电商平台规范的高转化率商品图。</p>
+          </div>
+          <div
+            className={styles.carousel}
+            role="region"
+            aria-label="轮播模板预览"
+            aria-roledescription="轮播"
+          >
+            <div
+              className={styles.template}
+              role="group"
+              aria-roledescription="幻灯片"
+              aria-label={`${index + 1} / ${templates.length}：${template.title}`}
+            >
+              <div className={styles.collage}>
+                <figure className={styles.sourceImages}>
+                  <figcaption>商品图</figcaption>
+                  <div>
+                    {[1, 2, 3].map((number) => (
+                      <img
+                        key={number}
+                        src={imageUrl(index + 1, "商品图", number)}
+                        alt={`${template.title}商品图${number}`}
+                        decoding="async"
+                      />
+                    ))}
+                  </div>
+                </figure>
+                <span className={styles.direction} aria-hidden="true">
+                  →
+                </span>
+                <figure className={styles.longPage}>
+                  <figcaption>详情长图</figcaption>
+                  <img
+                    src={imageUrl(index + 1, "详情长图", 1)}
+                    alt={`${template.title}详情长图`}
+                    decoding="async"
+                  />
+                </figure>
+                <figure className={styles.resultImages}>
+                  <figcaption>模块效果图</figcaption>
+                  <div>
+                    {[1, 2, 3, 4, 5, 6].map((number) => (
+                      <img
+                        key={number}
+                        src={imageUrl(index + 1, "效果图", number)}
+                        alt={`${template.title}效果图${number}`}
+                        decoding="async"
+                      />
+                    ))}
+                  </div>
+                </figure>
+              </div>
+              <span className={styles.sample} aria-live="polite">
+                {template.title} · A+ 详情页示例
+              </span>
+            </div>
+            <div className={styles.carouselControls}>
+              <button
+                type="button"
+                className={styles.arrow}
+                aria-label="上一组模板"
+                onClick={() =>
+                  setIndex(
+                    (value) =>
+                      (value + templates.length - 1) % templates.length,
+                  )
+                }
+              >
+                ‹
+              </button>
+              <div className={styles.dots} aria-label="轮播图导航">
+                {templates.map((item, itemIndex) => (
+                  <button
+                    type="button"
+                    key={item.title}
+                    aria-label={`查看${item.title}模板`}
+                    aria-current={index === itemIndex ? "true" : undefined}
+                    onClick={() => setIndex(itemIndex)}
+                  />
+                ))}
+              </div>
+              <button
+                type="button"
+                className={styles.arrow}
+                aria-label="下一组模板"
+                onClick={() =>
+                  setIndex((value) => (value + 1) % templates.length)
+                }
+              >
+                ›
+              </button>
+            </div>
+          </div>
+        </section>
+
+        <section
+          className={styles.actions}
+          aria-labelledby="guan-home-products"
+        >
+          <div>
+            <h2 id="guan-home-products">暂无产品</h2>
+            <p>从一个新产品开始，整理图片、提示词和画布。</p>
+          </div>
+          <div className={styles.buttons}>
+            <button type="button" className={styles.primary} onClick={onCreate}>
+              <span aria-hidden="true">＋</span>新建产品
+            </button>
+            <button type="button" disabled aria-describedby="guan-home-pending">
+              导入产品
+            </button>
+            <button type="button" disabled aria-describedby="guan-home-pending">
+              产品回收站
+            </button>
+          </div>
+          <p id="guan-home-pending" className={styles.note}>
+            产品导入与回收站尚未接入新基线。本页不会读取旧版数据。
+          </p>
+        </section>
+      </div>
+    </main>
+  );
+}
