diff --git a/web/tests/canvas-connection-routing.test.ts b/web/tests/canvas-connection-routing.test.ts
new file mode 100644
index 0000000..0af0cb8
--- /dev/null
+++ b/web/tests/canvas-connection-routing.test.ts
@@ -0,0 +1,43 @@
+import { expect, test } from "bun:test";
+
+import { buildConnectionRoutingMeta, routeConnection } from "../src/lib/canvas/canvas-connection-routing";
+
+const node = (x: number, y: number) => ({ position: { x, y }, width: 200, height: 120 });
+
+test("assigns stable fan-out and fan-in indexes by connection id", () => {
+    const connections = [
+        { id: "z", fromNodeId: "source", toNodeId: "target" },
+        { id: "a", fromNodeId: "source", toNodeId: "other" },
+        { id: "m", fromNodeId: "third", toNodeId: "target" },
+    ];
+    const meta = buildConnectionRoutingMeta(connections);
+    expect(meta.get("a")).toEqual({ sourceIndex: 0, sourceCount: 2, targetIndex: 0, targetCount: 1 });
+    expect(meta.get("z")).toEqual({ sourceIndex: 1, sourceCount: 2, targetIndex: 1, targetCount: 2 });
+    expect(meta.get("m")).toEqual({ sourceIndex: 0, sourceCount: 1, targetIndex: 0, targetCount: 2 });
+});
+
+test("produces rounded orthogonal routes for forward layouts", () => {
+    const route = routeConnection(node(0, 0), node(600, 220), { sourceIndex: 1, sourceCount: 3, targetIndex: 2, targetCount: 3 });
+    expect(route.d).toContain("Q");
+    expect(route.d).not.toContain("C");
+    expect(route.points[0]).toEqual({ x: 200, y: 60 });
+    expect(route.points[route.points.length - 1]).toEqual({ x: 600, y: 280 });
+    expect(route.bounds.top).toBeLessThan(60);
+    expect(route.bounds.bottom).toBeGreaterThan(280);
+});
+
+test("routes reverse layouts outside the cards before entering the target", () => {
+    const route = routeConnection(node(600, 220), node(0, 0));
+    expect(route.d).toContain("Q");
+    expect(route.points.some((point) => point.y < 0)).toBe(true);
+    expect(route.points[0]).toEqual({ x: 800, y: 280 });
+    expect(route.points[route.points.length - 1]).toEqual({ x: 0, y: 60 });
+});
+
+test("magnetic preview routing never mutates node positions", () => {
+    const source = node(0, 0);
+    const target = node(500, 300);
+    const before = JSON.stringify(target.position);
+    routeConnection(source, target);
+    expect(JSON.stringify(target.position)).toBe(before);
+});
