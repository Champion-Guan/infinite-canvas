index 0000000..a8e613e
--- /dev/null
+++ b/web/src/lib/canvas/canvas-connection-routing.ts
@@ -0,0 +1,159 @@
+import type { CanvasConnection, CanvasNodeData, Position } from "@/types/canvas";
+
+export type ConnectionRoutingIndex = {
+    sourceIndex: number;
+    sourceCount: number;
+    targetIndex: number;
+    targetCount: number;
+};
+
+export type ConnectionRouteBounds = {
+    left: number;
+    top: number;
+    right: number;
+    bottom: number;
+};
+
+export type ConnectionRoute = {
+    d: string;
+    points: Position[];
+    bounds: ConnectionRouteBounds;
+};
+
+const ROUTE_STUB = 28;
+const ROUTE_RADIUS = 12;
+const FANOUT_STEP = 12;
+const REVERSE_ROUTE_GAP = 64;
+
+function centerOffset(index: number, count: number) {
+    return (index - (count - 1) / 2) * FANOUT_STEP;
+}
+
+function samePoint(first: Position, second: Position) {
+    return first.x === second.x && first.y === second.y;
+}
+
+function isCollinear(first: Position, middle: Position, last: Position) {
+    return (middle.x - first.x) * (last.y - middle.y) === (middle.y - first.y) * (last.x - middle.x);
+}
+
+function simplifyPoints(points: Position[]) {
+    const compact = points.filter((point, index) => index === 0 || !samePoint(point, points[index - 1]));
+    return compact.filter((point, index) => index === 0 || index === compact.length - 1 || !isCollinear(compact[index - 1], point, compact[index + 1]));
+}
+
+function roundedPath(points: Position[], radius: number) {
+    const compact = simplifyPoints(points);
+    if (compact.length < 2) return `M ${compact[0]?.x || 0} ${compact[0]?.y || 0}`;
+
+    let path = `M ${compact[0].x} ${compact[0].y}`;
+    for (let index = 1; index < compact.length - 1; index += 1) {
+        const previous = compact[index - 1];
+        const current = compact[index];
+        const next = compact[index + 1];
+        const previousDistance = Math.hypot(current.x - previous.x, current.y - previous.y);
+        const nextDistance = Math.hypot(next.x - current.x, next.y - current.y);
+        const offset = Math.min(radius, previousDistance / 2, nextDistance / 2);
+        const before = {
+            x: current.x - ((current.x - previous.x) / previousDistance) * offset,
+            y: current.y - ((current.y - previous.y) / previousDistance) * offset,
+        };
+        const after = {
+            x: current.x + ((next.x - current.x) / nextDistance) * offset,
+            y: current.y + ((next.y - current.y) / nextDistance) * offset,
+        };
+        path += ` L ${before.x} ${before.y} Q ${current.x} ${current.y} ${after.x} ${after.y}`;
+    }
+    const last = compact[compact.length - 1];
+    path += ` L ${last.x} ${last.y}`;
+    return path;
+}
+
+function routeBounds(points: Position[], radius: number): ConnectionRouteBounds {
+    const xs = points.map((point) => point.x);
+    const ys = points.map((point) => point.y);
+    return {
+        left: Math.min(...xs) - radius,
+        top: Math.min(...ys) - radius,
+        right: Math.max(...xs) + radius,
+        bottom: Math.max(...ys) + radius,
+    };
+}
+
+export function getConnectionAnchors(from: Pick<CanvasNodeData, "position" | "width" | "height">, to: Pick<CanvasNodeData, "position" | "width" | "height">) {
+    return {
+        start: { x: from.position.x + from.width, y: from.position.y + from.height / 2 },
+        end: { x: to.position.x, y: to.position.y + to.height / 2 },
+    };
+}
+
+export function routeConnection(
+    from: Pick<CanvasNodeData, "position" | "width" | "height">,
+    to: Pick<CanvasNodeData, "position" | "width" | "height">,
+    routing: Partial<ConnectionRoutingIndex> = {},
+): ConnectionRoute {
+    const { start, end } = getConnectionAnchors(from, to);
+    const sourceOffset = centerOffset(routing.sourceIndex ?? 0, routing.sourceCount ?? 1);
+    const targetOffset = centerOffset(routing.targetIndex ?? 0, routing.targetCount ?? 1);
+    const sourceBranch = { x: start.x + ROUTE_STUB, y: start.y + sourceOffset };
+    const targetBranch = { x: end.x - ROUTE_STUB, y: end.y + targetOffset };
+    const forward = targetBranch.x > sourceBranch.x + ROUTE_STUB;
+    let points: Position[];
+
+    if (forward) {
+        const trunkX = (sourceBranch.x + targetBranch.x) / 2;
+        points = [
+            start,
+            { x: sourceBranch.x, y: start.y },
+            sourceBranch,
+            { x: trunkX, y: sourceBranch.y },
+            { x: trunkX, y: targetBranch.y },
+            targetBranch,
+            { x: targetBranch.x, y: end.y },
+            end,
+        ];
+    } else {
+        // When the target is visually behind the source, route above both cards. This
+        // keeps the final segment entering the target from its left anchor instead of
+        // drawing through the target card.
+        const lane = Math.max(Math.abs(sourceOffset), Math.abs(targetOffset));
+        const safeY = Math.min(from.position.y, to.position.y) - REVERSE_ROUTE_GAP - lane;
+        points = [
+            start,
+            { x: sourceBranch.x, y: start.y },
+            { x: sourceBranch.x, y: safeY + sourceOffset },
+            { x: targetBranch.x, y: safeY + targetOffset },
+            { x: targetBranch.x, y: end.y },
+            end,
+        ];
+    }
+
+    const compact = simplifyPoints(points);
+    return { d: roundedPath(compact, ROUTE_RADIUS), points: compact, bounds: routeBounds(compact, ROUTE_RADIUS) };
+}
+
+export function buildConnectionRoutingMeta(connections: CanvasConnection[]) {
+    const sourceGroups = new Map<string, CanvasConnection[]>();
+    const targetGroups = new Map<string, CanvasConnection[]>();
+    connections.forEach((connection) => {
+        const sources = sourceGroups.get(connection.fromNodeId) || [];
+        sources.push(connection);
+        sourceGroups.set(connection.fromNodeId, sources);
+        const targets = targetGroups.get(connection.toNodeId) || [];
+        targets.push(connection);
+        targetGroups.set(connection.toNodeId, targets);
+    });
+
+    const result = new Map<string, ConnectionRoutingIndex>();
+    connections.forEach((connection) => {
+        const sources = [...(sourceGroups.get(connection.fromNodeId) || [])].sort((first, second) => first.id.localeCompare(second.id));
+        const targets = [...(targetGroups.get(connection.toNodeId) || [])].sort((first, second) => first.id.localeCompare(second.id));
+        result.set(connection.id, {
+            sourceIndex: sources.findIndex((item) => item.id === connection.id),
+            sourceCount: sources.length,
+            targetIndex: targets.findIndex((item) => item.id === connection.id),
+            targetCount: targets.length,
+        });
+    });
+    return result;
+}
