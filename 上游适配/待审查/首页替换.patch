+import { useState } from "react";
+import styles from "./首页.module.css";
+
+const templates = [
+    { title: "主图展示", description: "清楚展示产品主体与细节", labels: ["产品主图", "材质细节", "使用场景"] },
+    { title: "尺寸展示", description: "让尺寸、比例与规格一目了然", labels: ["整体尺寸", "局部尺寸", "规格对照"] },
+    { title: "核心卖点", description: "用有层次的画面表达产品特点", labels: ["产品特点", "细节说明", "场景展示"] },
+] as const;
+
+type Props = { theme: "light" | "dark"; onCreate: () => void };
+
+// 恢复旧版两列首页布局；不加载旧归档页面、DOM脚本或第三方轮播图片。
+export function WorkbenchHome({ theme, onCreate }: Props) {
+    const [index, setIndex] = useState(0);
+    const template = templates[index];
+
+    return (
+        <main className={styles.page} data-theme={theme} aria-label="工作台首页">
+            <div className={styles.columns}>
+                <section className={styles.preview} aria-labelledby="guan-home-title">
+                    <div>
+                        <h1 id="guan-home-title">A+ 详情页</h1>
+                        <p>上传商品图，AI 即刻生成符合多电商平台规范的高转化率商品图。</p>
+                    </div>
+                    <div className={styles.carousel} role="region" aria-label="轮播模板预览" aria-roledescription="轮播">
+                        <div className={styles.template} role="group" aria-roledescription="幻灯片" aria-label={`${index + 1} / ${templates.length}：${template.title}`}>
+                            <div className={styles.templateHeader} aria-live="polite">
+                                <strong>{template.title}</strong>
+                                <span>{template.description}</span>
+                            </div>
+                            <div className={styles.cards}>
+                                {template.labels.map((label, cardIndex) => (
+                                    <div className={styles.card} key={cardIndex}>
+                                        <svg viewBox="0 0 160 150" fill="none" aria-hidden="true">
+                                            <ellipse cx="80" cy="128" rx="42" ry="8" fill="currentColor" opacity=".07" />
+                                            <rect x="51" y="30" width="58" height="91" rx="13" fill="currentColor" opacity=".10" />
+                                            <rect x="63" y="18" width="34" height="17" rx="5" fill="currentColor" opacity=".23" />
+                                            <rect x="60" y="63" width="40" height="29" rx="4" stroke="currentColor" opacity=".35" />
+                                            {index === 1 ? <path d="M123 31v90m-4-90h8m-8 90h8M51 136h58m-58-4v8m58-8v8" stroke="currentColor" opacity=".6" /> : null}
+                                        </svg>
+                                        <span>{label}</span>
+                                    </div>
+                                ))}
+                            </div>
+                            <span className={styles.sample}>布局示意 · 非实际生成图片</span>
+                        </div>
+                        <div className={styles.carouselControls}>
+                            <button type="button" className={styles.arrow} aria-label="上一组模板" onClick={() => setIndex((value) => (value + templates.length - 1) % templates.length)}>‹</button>
+                            <div className={styles.dots} aria-label="轮播图导航">
+                                {templates.map((item, itemIndex) => (
+                                    <button type="button" key={item.title} aria-label={`查看${item.title}模板`} aria-current={index === itemIndex ? "true" : undefined} onClick={() => setIndex(itemIndex)} />
+                                ))}
+                            </div>
+                            <button type="button" className={styles.arrow} aria-label="下一组模板" onClick={() => setIndex((value) => (value + 1) % templates.length)}>›</button>
+                        </div>
+                    </div>
+                </section>
+
+                <section className={styles.actions} aria-labelledby="guan-home-products">
+                    <div>
+                        <h2 id="guan-home-products">暂无产品</h2>
+                        <p>从一个新产品开始，整理图片、提示词和画布。</p>
+                    </div>
+                    <div className={styles.buttons}>
+                        <button type="button" className={styles.primary} onClick={onCreate}><span aria-hidden="true">＋</span>新建产品</button>
+                        <button type="button" disabled aria-describedby="guan-home-pending">导入产品</button>
+                        <button type="button" disabled aria-describedby="guan-home-pending">产品回收站</button>
+                    </div>
+                    <p id="guan-home-pending" className={styles.note}>产品导入与回收站尚未接入新基线。本页不会读取旧版数据。</p>
+                </section>
+            </div>
+        </main>
+    );
+}
