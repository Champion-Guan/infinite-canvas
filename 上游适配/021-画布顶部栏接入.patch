+function subscribeSaveStatus(callback: () => void) {
+    window.addEventListener("guan:storage-status", callback);
+    return () => window.removeEventListener("guan:storage-status", callback);
+}
+
+function readSaveStatus() {
+    const status = storageStatus();
+    if (status.state === "error" || status.reconnectError) return "error";
+    return status.state === "saved" && !status.pending && !status.retrying ? "saved" : "saving";
+}
+
+function CanvasSaveStatus({ pending }: { pending: boolean }) {
+    const status = useSyncExternalStore(subscribeSaveStatus, readSaveStatus, () => "saving");
+    const colorTheme = useThemeStore((state) => state.theme);
+    const theme = canvasThemes[colorTheme];
+    const failed = status === "error";
+    const saving = !failed && (pending || status === "saving");
+    return (
+        <span className="guan-canvas-save-status flex h-8 items-center gap-1.5 text-xs" style={{ color: failed ? "#dc2626" : saving ? "#d97706" : theme.node.muted }} aria-live="polite" data-canvas-save-status={failed ? "error" : saving ? "saving" : "saved"}>
+            <span className="size-2 rounded-full" style={{ background: failed ? "#dc2626" : saving ? "#f59e0b" : "#22c55e" }} />
+            <span className="max-w-[140px] truncate">{failed ? "保存失败" : saving ? "保存中…" : "已保存"}</span>
+        </span>
+    );
+}
